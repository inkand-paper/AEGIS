# ── Provider (required) ──────────────────────────────────────────────────────
# groq | gemini | openai | anthropic | openrouter | ollama | custom
AEGIS_PROVIDER=groq
AEGIS_API_KEY=

# ── Model name (optional — each provider has a sensible default) ──────────────
# Gemini:            gemini-3.5-flash-lite (default); gemini-3.8-flash is also stable
# Groq free tier:    openai/gpt-oss-120b  (default; the benchmark baseline model)
# OpenAI:            gpt-4o-mini  (default)
# Anthropic:         claude-sonnet-5-5  (default)
# AEGIS_MODEL=

# Rate limiting (optional). Set to 0 if you are on a paid plan.
# AEGIS_MIN_INTERVAL_S=8   # seconds between model calls; free-tier Gemini default is 8

# ── Paths ─────────────────────────────────────────────────────────────────────
AEGIS_DATA_DIR=data
AEGIS_WORKSPACES_DIR=workspaces

# ── Docker sandbox (submit --sandbox). Defaults shown; all optional. ──────────
# AEGIS_SANDBOX_IMAGE=aegis-sandbox:latest
# AEGIS_SANDBOX_MEMORY_MB=256
# AEGIS_SANDBOX_CPUS=1.0
# AEGIS_SANDBOX_PIDS=64
# AEGIS_SANDBOX_TIMEOUT_S=30

# ── Image generation (image_generate). Default is offline test provider. ─────
# AEGIS_IMAGE_PROVIDER=procedural   # procedural | openai | custom
# AEGIS_IMAGE_API_KEY=
# AEGIS_IMAGE_BASE_URL=             # custom only, e.g. https://host/v1
# AEGIS_IMAGE_MODEL=

