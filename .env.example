AEGIS_PROVIDER=
AEGIS_API_KEY=
AEGIS_DATA_DIR=data
AEGIS_WORKSPACES_DIR=workspaces

# Docker sandbox (submit --sandbox). Defaults shown; all optional.
# AEGIS_SANDBOX_IMAGE=aegis-sandbox:latest
# AEGIS_SANDBOX_MEMORY_MB=256
# AEGIS_SANDBOX_CPUS=1.0
# AEGIS_SANDBOX_PIDS=64
# AEGIS_SANDBOX_TIMEOUT_S=30

# Image generation (image_generate). The default is the offline test provider: it needs nothing
# and makes abstract pictures that do NOT depict the prompt.
# AEGIS_IMAGE_PROVIDER=procedural   # procedural | openai | custom
# AEGIS_IMAGE_API_KEY=
# AEGIS_IMAGE_BASE_URL=             # custom only, for example https://host/v1
# AEGIS_IMAGE_MODEL=
